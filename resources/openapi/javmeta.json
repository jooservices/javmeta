        ],
        "security": [
          {
            "ApiKey": []
          }
        ],
        "x-scope": "movies",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Missing or invalid API key"
          },
          "403": {
            "description": "The key has no access to this scope"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "required": false,
            "description": "YYYY-MM, default the current month",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/movies:bulk": {
      "post": {
        "summary": "Look up many movies by code",
        "tags": [
          "api"
        ],
        "security": [
          {
            "ApiKey": []
          }
        ],
        "x-scope": "bulk",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Missing or invalid API key"
          },
          "403": {
            "description": "The key has no access to this scope"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "codes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/performers": {
      "get": {
