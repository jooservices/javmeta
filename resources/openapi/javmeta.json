          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "name, updated_at or linked_title_count",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Cursor",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "1 to 100",
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
