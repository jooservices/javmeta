{
  "openapi": "3.0.3",
  "info": {
    "title": "JavMeta API",
    "version": "1.0.0",
    "description": "Movie and performer metadata crawled from many sources. Send the key in the X-API-Key header. A key may be limited to scopes: movies, bulk, performers, catalog, status, mcp."
  },
  "servers": [
    {
      "url": "https://jav.soulevil.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Service health",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    },
    "/api/health/live": {
      "get": {
        "summary": "Liveness",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Alive"
          }
        }
      }
    },
    "/api/v1/auth/verify": {
      "get": {
        "summary": "Check that the API key works",
        "tags": [
          "api"
        ],
        "security": [
          {
            "ApiKey": []
          }
        ],
        "x-scope": "none",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Missing or invalid API key"
          },
          "403": {
            "description": "The key has no access to this scope"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/v1/movies": {
      "get": {
        "summary": "Search and list movies",
        "tags": [
          "api"
        ],
        "security": [
          {
            "ApiKey": []
          }
        ],
        "x-scope": "movies",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Missing or invalid API key"
          },
          "403": {
            "description": "The key has no access to this scope"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Text, at least 2 characters",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code",
            "in": "query",
            "required": false,
            "description": "Movie code",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "genre",
            "in": "query",
            "required": false,
            "description": "Genre name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "actress",
            "in": "query",
            "required": false,
            "description": "Performer name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "maker",
            "in": "query",
            "required": false,
            "description": "Maker",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "series",
            "in": "query",
            "required": false,
            "description": "Series",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "label",
            "in": "query",
            "required": false,
            "description": "Label",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "released_from",
            "in": "query",
            "required": false,
            "description": "YYYY-MM-DD",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "released_to",
            "in": "query",
            "required": false,
            "description": "YYYY-MM-DD",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "runtime_min",
            "in": "query",
            "required": false,
            "description": "Minutes",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "runtime_max",
            "in": "query",
            "required": false,
            "description": "Minutes",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "censored",
            "in": "query",
            "required": false,
            "description": "0, 1, censored or uncensored",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "relevance, release_date, update_date or rating",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Cursor of the next page",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "1 to 100",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "semantic",
            "in": "query",
            "required": false,
            "description": "1 for search by meaning (only q and per_page)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
