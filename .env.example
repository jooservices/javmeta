APP_NAME=javmeta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Sentry error reporting. Keep the DSN in the private Workspaces root .env.
JAVMETA_SENTRY_DSN=
JAVMETA_SENTRY_TRACES_SAMPLE_RATE=0
JAVMETA_ROLE=api
JAVMETA_NODE_NAME=unknown

# Compose profiles enabled by default (local stack = everything in Docker).
#   app,data,openobserve,flare,control → local full stack (develop default)
#   app,flare                          → production crawler instance
#   app,control                        → production control instance (scheduler + mcp, run once)
#   app                                → external mode (data/obs/flare point outside)
COMPOSE_PROFILES=app,data,openobserve,flare,control

# Semantic search embedding service (optional container, profile `embed`).
# Run on the parent node only; crawler nodes point EMBEDDER_URL at it.
#   parent node: EMBEDDER_URL=http://embedder:8000
#   other nodes: EMBEDDER_URL=http://192.168.10.100:8000
EMBEDDER_URL=http://embedder:8000
EMBEDDER_HOST_PORT=8000

# Number of worker containers started by `make up` / `docker compose up --scale worker=…`.
JAVMETA_WORKER_INSTANCES=2

# Primary database (System of Record). Default = bundled Compose `postgres`.
# External DB: point DB_HOST/DB_PORT to the remote host and keep creds here.
# MySQL/MariaDB: switch DB_CONNECTION=mysql (pdo_mysql ships in the image).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=jvmeta
DB_USERNAME=jvmeta
DB_PASSWORD=jvmeta
DB_SSLMODE=prefer

# Host-side bind ports for the bundled internal DB services. Change these when
# an external DB already occupies the default host port. Ignored if you use
# external databases and `docker compose stop postgres mongo elasticsearch`.
POSTGRES_HOST_PORT=5432
MONGO_HOST_PORT=27017
ELASTICSEARCH_HOST_PORT=9200

QUEUE_CONNECTION=database
CACHE_STORE=database
# Redis queue data uses a project prefix; tests override it with javmeta_it:.
REDIS_PREFIX=javmeta:
HORIZON_PREFIX=javmeta:horizon:
REDIS_QUEUE_RETRY_AFTER=240
# Maximum ready Laravel jobs buffered for each crawl queue.
JAVMETA_QUEUE_DEPTH_LIMIT=100
# Worker timeout; keep it below the selected queue connection's retry window.
JAVMETA_QUEUE_TIMEOUT=180
# Database jobs remain reserved beyond the worker timeout.
DB_QUEUE_RETRY_AFTER=240

# Mongo archive (per-site raw snapshots + activity log). Default = bundled
# Compose `mongo`. External Mongo: set MONGO_URI to a full connection string
# (takes precedence over MONGO_HOST/PORT), or point MONGO_HOST/PORT remote.
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DATABASE=javmeta_archive
MONGO_URI=
ACTIVITY_LOG_CONNECTION=mongodb
ACTIVITY_LOG_COLLECTION=activity_logs

# Elasticsearch search index. Default = bundled Compose `elasticsearch`.
# External ES: point ELASTICSEARCH_HOST to the remote URL.
ELASTICSEARCH_HOST=http://elasticsearch:9200
ELASTICSEARCH_MOVIES_INDEX=javmeta_movies
ELASTICSEARCH_PERFORMERS_INDEX=javmeta_performers

# crawlerx browser chain (Playwright / stealth / FlareSolverr)
CRAWLERX_NODE=node
CRAWLERX_PLAYWRIGHT_SCRIPT=/var/www/html/vendor/jooservices/crawlerx/scripts/playwright-fetch.mjs
CRAWLERX_PUPPETEER_SCRIPT=/var/www/html/vendor/jooservices/crawlerx/scripts/puppeteer-stealth-fetch.mjs
CRAWLERX_FLARESOLVERR_URL=http://flaresolverr:8191/v1
JAVMETA_WORKERS_PER_QUEUE=1
JAVMETA_QUEUE_NAMES=listing,detail,performer_listing,performer_detail,gallery

# Alerts via jooservices/laravel-notifications (Telegram channel)
# Master switch: false disables all alerts (telegram + activity log).
JAVMETA_ALERTS_ENABLED=true
NOTIFICATION_TELEGRAM_BOT_TOKEN=
NOTIFICATION_TELEGRAM_CHAT_ID=
# Optional Slack / mail channels (laravel-notifications)
# NOTIFICATION_SLACK_WEBHOOK_URL=
# NOTIFICATION_MAIL_MAILER= / NOTIFICATION_MAIL_TO=
JAVMETA_OWNER_ADMIN_TOKEN=
# Active jvm_… key required for `php artisan mcp:serve` / compose profile mcp
JAVMETA_MCP_API_KEY=

# OpenObserve (Compose service `openobserve`, UI http://localhost:5080)
OPENOBSERVE_ENABLED=true
OPENOBSERVE_URL=http://openobserve:5080
OPENOBSERVE_ORG=default
OPENOBSERVE_STREAM_LOGS=javmeta_logs
OPENOBSERVE_STREAM_METRICS=javmeta_metrics
OPENOBSERVE_EMAIL=root@javmeta.local
OPENOBSERVE_PASSWORD=Complexpass#123
OPENOBSERVE_TIMEOUT=3
OPENOBSERVE_TRACE_SAMPLE_RATE=1.0
ZO_ROOT_USER_EMAIL=root@javmeta.local
ZO_ROOT_USER_PASSWORD=Complexpass#123
LOG_STACK=single,openobserve

# Seconds a blocked or challenged crawl waits before each retry; the next block after the last delay fails the row.
JAVMETA_BLOCK_DELAYS=60,120,180
