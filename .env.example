# Bootstrap values needed before the database settings store is available.
APP_NAME=javmeta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
JAVMETA_SENTRY_DSN=
JAVMETA_ROLE=api
JAVMETA_NODE_NAME=unknown

# Compose topology and host bind ports.
COMPOSE_PROFILES=app,data,openobserve,flare,control
EMBEDDER_HOST_PORT=8000
JAVMETA_WORKER_INSTANCES=2
POSTGRES_HOST_PORT=5432
MONGO_HOST_PORT=27017
ELASTICSEARCH_HOST_PORT=9200

# Primary database (System of Record).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=javmeta
DB_USERNAME=javmeta
DB_PASSWORD=
DB_SSLMODE=prefer

# Queue, cache, session and infrastructure transports.
QUEUE_CONNECTION=redis
CACHE_STORE=database
REDIS_HOST=host.docker.internal
REDIS_PORT=16382
REDIS_PREFIX=javmeta:
HORIZON_PREFIX=javmeta:horizon:
SESSION_DRIVER=redis
SESSION_CONNECTION=default

# MongoDB raw archive and activity log.
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DATABASE=javmeta_archive
MONGO_URI=
ACTIVITY_LOG_CONNECTION=mongodb
ACTIVITY_LOG_COLLECTION=activity_logs

# Elasticsearch connection and credentials; index names and TLS policy are Settings values.
ELASTICSEARCH_HOST=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=

# OpenObserve connection and credentials; org, streams, switches and timeouts are Settings values.
OPENOBSERVE_URL=http://openobserve:5080
OPENOBSERVE_EMAIL=root@javmeta.local
OPENOBSERVE_PASSWORD=
ZO_ROOT_USER_EMAIL=root@javmeta.local
ZO_ROOT_USER_PASSWORD=

# Framework logging bootstrap.
LOG_STACK=single,openobserve

# Worker counts, queue limits, feature switches, service addresses, models,
# cleanup ages, retries and other runtime settings are managed in Cài đặt.
