<?xml version="1.0" encoding="UTF-8"?>
<!-- Integration suite: real shared or CI Postgres, Mongo, Redis, Elasticsearch and OpenObserve. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache/integration"
>
    <testsuites>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <php>
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>
        <env name="APP_NAME" value="javmeta" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="jvmeta_it"/>
        <env name="DB_USERNAME" value="jvmeta"/>
        <env name="DB_PASSWORD" value="jvmeta"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MONGO_DATABASE" value="javmeta_it_archive"/>
        <env name="MONGODB_URI" value=""/>
        <env name="MONGO_URI" value=""/>
        <env name="ELASTICSEARCH_MOVIES_INDEX" value="javmeta_it_movies"/>
        <env name="ELASTICSEARCH_PERFORMERS_INDEX" value="javmeta_it_performers"/>
        <env name="EMBEDDER_URL" value="http://embedder.test" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="REDIS_PREFIX" value="javmeta_it:"/>
        <env name="HORIZON_PREFIX" value="javmeta_it:horizon:"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="OPENOBSERVE_ENABLED" value="false" force="true"/>
        <env name="OPENOBSERVE_ORG" value="default"/>
        <env name="OPENOBSERVE_STREAM_LOGS" value="javmeta_it_logs"/>
        <env name="LOG_STACK" value="single" force="true"/>
        <env name="NOTIFICATION_TELEGRAM_BOT_TOKEN" value="" force="true"/>
        <env name="NOTIFICATION_TELEGRAM_CHAT_ID" value="" force="true"/>
        <env name="TELEGRAM_BOT_TOKEN" value="" force="true"/>
        <env name="TELEGRAM_CHAT_ID" value="" force="true"/>
    </php>
</phpunit>
