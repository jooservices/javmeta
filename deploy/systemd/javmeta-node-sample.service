[Unit]
Description=JavMeta per-node resource and Horizon worker sample
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=%h/Workspaces/JOOservices/projects/javmeta
ExecStart=%h/Workspaces/scripts/docker/runtime php@8.5 php %h/Workspaces/JOOservices/projects/javmeta/artisan node:sample
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
