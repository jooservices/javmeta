[Unit]
Description=JavMeta scheduler (exactly one instance) in the shared PHP 8.5 runtime
After=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=%h/Workspaces/JOOservices/projects/javmeta
ExecStart=%h/Workspaces/scripts/docker/runtime php@8.5 php %h/Workspaces/JOOservices/projects/javmeta/artisan schedule:work
# Match the absolute JavMeta artisan path so another project scheduler cannot be stopped.
ExecStopPost=-%h/Workspaces/scripts/docker/runtime php@8.5 pkill -f "[j]avmeta/artisan schedule:work"
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
