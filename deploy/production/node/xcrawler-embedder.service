[Unit]
Description=XCrawler embedder
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/www/xcrawler/current/artisan

[Service]
Type=simple
User=xcrawler
Group=xcrawler
WorkingDirectory=/var/www/xcrawler/current
Environment=HOME=/var/www/xcrawler/shared
Environment=HF_HOME=/var/www/xcrawler/shared/huggingface
Environment=HF_HUB_DISABLE_TELEMETRY=1
ExecStart=/var/www/xcrawler/shared/embedder-venv/bin/uvicorn app:app --app-dir /var/www/xcrawler/current/embedder --host 127.0.0.1 --port 8000
Restart=always
RestartSec=15
TimeoutStopSec=240
KillSignal=SIGTERM
KillMode=mixed
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/www/xcrawler/shared/storage /var/www/xcrawler/shared/huggingface

[Install]
WantedBy=multi-user.target
