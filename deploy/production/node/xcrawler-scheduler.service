[Unit]
Description=XCrawler scheduler
After=network-online.target
Wants=network-online.target
ConditionPathExists=@TARGET_DIR@/current/artisan

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@TARGET_DIR@/current
Environment=HOME=@TARGET_DIR@/shared
Environment=HF_HUB_DISABLE_TELEMETRY=1
ExecStart=@PHP_BINARY@ artisan schedule:work
Restart=always
RestartSec=15
TimeoutStopSec=240
KillSignal=SIGTERM
KillMode=mixed
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=@TARGET_DIR@/shared/storage

[Install]
WantedBy=multi-user.target
