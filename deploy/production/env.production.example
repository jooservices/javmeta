# Native XCrawler node only; no Docker/Compose variables. Secrets stay empty.
APP_NAME=XCrawler
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://xcrawler.net
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
JAVMETA_NODE_NAME=xcrawler
JAVMETA_ROLE=api
# PostgreSQL: application migrations run as this owner, never as admin.
DB_CONNECTION=pgsql
DB_HOST=192.168.10.12
DB_PORT=5432
DB_DATABASE=xcrawler
DB_USERNAME=xcrawler
DB_PASSWORD=
DB_SSLMODE=prefer
# MongoDB user xcrawler exists on .13; password is empty below: fill privately.
# config/database.php reads MONGO_URI for username/password/authSource.
# Percent-encode the password in the URI; add VM-required TLS options.
MONGO_HOST=192.168.10.13
MONGO_PORT=27017
MONGO_DATABASE=xcrawler
# Format: mongodb://xcrawler:<percent-encoded password>@192.168.10.13:27017/xcrawler?authSource=xcrawler
MONGO_URI=
ACTIVITY_LOG_CONNECTION=mongodb
ACTIVITY_LOG_COLLECTION=activity_logs
# Redis ACL is prefix scoped. Never use cache:clear/FLUSHDB with this account.
REDIS_CLIENT=phpredis
REDIS_HOST=192.168.10.14
REDIS_PORT=6379
REDIS_USERNAME=xcrawler
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=xcrawler:
HORIZON_PREFIX=xcrawler:horizon:
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=xcrawler:cache:
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_COOKIE=xcrawler_session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Host-only cookies: sign in separately on the command center.
SESSION_DOMAIN=
# Elasticsearch: install the issuing CA in the node trust store first.
ELASTICSEARCH_HOST=https://192.168.10.15:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_VERIFY_SSL=true
ELASTICSEARCH_MOVIES_INDEX=xcrawler_movies
ELASTICSEARCH_PERFORMERS_INDEX=xcrawler_performers
EMBEDDER_URL=http://127.0.0.1:8000
# Browser endpoints and release symlink path (not an immutable commit directory).
CRAWLERX_NODE=/usr/bin/node
CRAWLERX_PLAYWRIGHT_SCRIPT=/var/www/xcrawler/current/vendor/jooservices/crawlerx/scripts/playwright-fetch.mjs
FLARESOLVERR_URL=http://192.168.10.19:8191/v1
PLAYWRIGHT_URL=http://192.168.10.19:3000
# OpenObserve: endpoint/identity only; enable and sample rate are database settings.
OPENOBSERVE_URL=http://192.168.10.18:5080
OPENOBSERVE_ORG=default
OPENOBSERVE_STREAM_LOGS=xcrawler_logs
OPENOBSERVE_STREAM_METRICS=xcrawler_metrics
OPENOBSERVE_SERVICE_NAME=XCrawler
OPENOBSERVE_EMAIL=
OPENOBSERVE_PASSWORD=
LOG_CHANNEL=stack
LOG_STACK=daily,openobserve
LOG_LEVEL=info
# Sentry project xcrawler: copy its DSN from project settings into this private file.
JAVMETA_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
# Optional legacy admin/MCP integrations; create keys in UI instead where supported.
JAVMETA_OWNER_ADMIN_TOKEN=
JAVMETA_MCP_API_KEY=
# Local mail only; configure a supported transport privately if email is required.
MAIL_MAILER=log
