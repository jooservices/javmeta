                "y": [
                  {
                    "label": "p95 ms",
                    "alias": "y_axis_1",
                    "column": "parse_duration_ms",
                    "color": "#5960b2",
                    "isDerived": false,
                    "havingConditions": []
                  }
                ],
                "z": [],
                "breakdown": [],
