{
  "version": 8,
  "title": "JAVMETA Search parse",
  "description": "Privacy-safe natural-language parser request rate, cache performance, backend selection and Ollama outcomes.",
  "tabs": [
    {
      "tabId": "default",
      "name": "Search parse",
      "panels": [
        {
          "id": "search-parse-request-rate",
          "type": "line",
          "title": "Parse requests by cache status",
          "description": "Requests per minute, split between parse-cache hits and misses.",
          "config": {
            "show_legends": true,
            "legends_position": null,
            "unit": "numbers",
            "base_map": null,
            "map_view": null
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp, '1 minute') AS \"x_axis_1\", count(*) AS \"y_axis_1\", parse_cache_status AS \"breakdown_1\" FROM \"javmeta_logs\" WHERE event = 'api_usage' AND endpoint = '/api/v1/search/parse' GROUP BY x_axis_1, breakdown_1 ORDER BY x_axis_1",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": {
                "stream": "javmeta_logs",
                "stream_type": "logs",
                "x": [
                  {
                    "label": "Time",
                    "alias": "x_axis_1",
                    "column": "_timestamp",
                    "color": null,
                    "isDerived": false,
                    "havingConditions": []
                  }
                ],
                "y": [
                  {
                    "label": "Requests",
                    "alias": "y_axis_1",
                    "column": "_timestamp",
                    "color": "#5960b2",
                    "isDerived": false,
                    "havingConditions": []
                  }
                ],
                "z": [],
                "breakdown": [
                  {
                    "label": "Cache status",
                    "alias": "breakdown_1",
                    "column": "parse_cache_status",
                    "color": null,
                    "isDerived": false,
                    "havingConditions": []
                  }
                ],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": "",
                "layer_type": "line",
                "weight_fixed": 1.0,
                "limit": 0.0,
                "min": 0.0,
                "max": 0.0,
                "time_shift": []
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 0,
            "w": 96,
            "h": 18,
            "i": 0
          }
        },
        {
          "id": "search-parse-p95-by-cache",
          "type": "bar",
          "title": "Parse p95 latency by cache status",
          "description": "Parse-handler latency in milliseconds; acceptance targets are under 4 seconds for misses and 100 ms for hits.",
          "config": {
            "show_legends": true,
            "legends_position": null,
            "unit": "milliseconds",
            "base_map": null,
            "map_view": null
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT parse_cache_status AS \"x_axis_1\", round(approx_percentile_cont(parse_duration_ms, 0.95)) AS \"y_axis_1\" FROM \"javmeta_logs\" WHERE event = 'api_usage' AND endpoint = '/api/v1/search/parse' AND parse_duration_ms IS NOT NULL GROUP BY x_axis_1 ORDER BY x_axis_1",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": {
                "stream": "javmeta_logs",
                "stream_type": "logs",
