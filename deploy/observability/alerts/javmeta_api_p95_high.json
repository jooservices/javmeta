{
  "name": "javmeta_api_p95_high",
  "description": "API response latency p95 is above 1500 ms.",
  "enabled": true,
  "is_real_time": false,
  "stream_type": "metrics",
  "stream_name": "javmeta_api_p95_ms_1m",
  "query_condition": {
    "type": "sql",
    "sql": "SELECT _timestamp, value FROM \"javmeta_api_p95_ms_1m\" WHERE value > 1500"
  },
  "trigger_condition": {
    "frequency_type": "minutes",
    "frequency": 1,
    "period": 10,
    "operator": ">",
    "threshold": 0,
    "silence": 60
  },
  "pending_period_sec": 0,
  "destinations": [
    "javmeta_telegram"
  ]
}
