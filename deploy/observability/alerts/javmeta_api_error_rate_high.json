{
  "name": "javmeta_api_error_rate_high",
  "description": "API error rate is at least five percent over the latest published interval.",
  "enabled": true,
  "is_real_time": false,
  "stream_type": "metrics",
  "stream_name": "javmeta_api_error_rate_1m",
  "query_condition": {
    "type": "sql",
    "sql": "SELECT _timestamp, value FROM \"javmeta_api_error_rate_1m\" WHERE value >= 0.05"
  },
  "trigger_condition": {
    "frequency_type": "minutes",
    "frequency": 1,
    "period": 5,
    "operator": ">",
    "threshold": 0,
    "silence": 15
  },
  "pending_period_sec": 0,
  "destinations": [
    "javmeta_telegram"
  ]
}
