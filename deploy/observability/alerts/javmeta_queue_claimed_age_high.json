{
  "name": "javmeta_queue_claimed_age_high",
  "description": "The oldest claimed crawl row has been claimed for more than 30 minutes (stuck worker or lost job).",
  "enabled": true,
  "is_real_time": false,
  "stream_type": "metrics",
  "stream_name": "javmeta_crawl_queue_claimed_age_seconds",
  "query_condition": {
    "type": "sql",
    "sql": "SELECT _timestamp, value FROM \"javmeta_crawl_queue_claimed_age_seconds\" WHERE value > 1800"
  },
  "trigger_condition": {
    "frequency_type": "minutes",
    "frequency": 1,
    "period": 10,
    "operator": ">",
    "threshold": 0,
    "silence": 60
  },
  "pending_period_sec": 0,
  "destinations": [
    "javmeta_telegram"
  ]
}
