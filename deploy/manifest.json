  "node": {
    "os_release": "/etc/os-release",
    "minimum_ubuntu": 24,
    "php_ppa": "ppa:ondrej/php",
    "node_key": "https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key",
    "node_repo": "https://deb.nodesource.com/node_24.x",
    "pg_key": "https://www.postgresql.org/media/keys/ACCC4CF8.asc",
    "pg_repo": "https://apt.postgresql.org/pub/repos/apt",
    "composer_installer": "https://getcomposer.org/installer",
    "composer_signature": "https://composer.github.io/installer.sig",
    "composer_dir": "/usr/local/bin",
    "sudoers_dir": "/etc/sudoers.d",
    "unit_dir": "/etc/systemd/system",
    "fpm_pool_dir": "/etc/php/8.5/fpm/pool.d",
    "nginx_available": "/etc/nginx/sites-available",
    "nginx_enabled": "/etc/nginx/sites-enabled",
    "node_key_path": "/usr/share/keyrings/nodesource.gpg",
    "node_list_path": "/etc/apt/sources.list.d/nodesource.list",
    "pg_key_path": "/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc",
    "pg_list_path": "/etc/apt/sources.list.d/pgdg.list",
    "packages": [
      "ca-certificates",
      "curl",
      "gnupg",
      "software-properties-common",
      "git",
      "gh",
      "unzip",
      "jq",
      "nginx",
      "python3-venv",
      "python3-pip",
      "redis-tools",
      "prometheus-node-exporter",
      "sudo"
    ],
    "runtime_packages": [
      "php8.5-cli",
      "php8.5-fpm",
      "php8.5-pgsql",
      "php8.5-mongodb",
      "php8.5-redis",
      "php8.5-intl",
