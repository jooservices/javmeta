<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache/e2e"
>
    <testsuites>
        <testsuite name="E2E unit steps">
            <directory>tests/E2E/Unit</directory>
        </testsuite>
        <testsuite name="E2E journeys">
            <file>tests/E2E/E2EJourneysTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <file>tests/E2E/Context.php</file>
            <file>tests/E2E/Scenario.php</file>
            <file>tests/E2E/Step.php</file>
            <directory>tests/E2E/Steps</directory>
            <directory>tests/E2E/Scenarios</directory>
            <directory>tests/E2E/Support</directory>
        </include>
        <exclude>
            <!-- This HTTP router is a fixture server, not harness logic. -->
            <file>tests/E2E/Support/embedder-router.php</file>
        </exclude>
    </source>
    <php>
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>
        <env name="APP_NAME" value="javmeta" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="NOTIFICATION_TELEGRAM_BOT_TOKEN" value="" force="true"/>
        <env name="NOTIFICATION_TELEGRAM_CHAT_ID" value="" force="true"/>
        <env name="TELEGRAM_BOT_TOKEN" value="" force="true"/>
        <env name="TELEGRAM_CHAT_ID" value="" force="true"/>
    </php>
</phpunit>
