#!/usr/bin/env bash
# Run CaptainHook inside the CI image (docker/ci/run) so host PHP extensions never
# matter. Set JAVMETA_HOOKS_ON_HOST=1 to use host PHP instead.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if [[ ! -x vendor/bin/captainhook ]]; then
    case " $* " in
        *" hook:post-"*)
            echo "run-captainhook: vendor/ missing, skipping non-gating hook (run: docker/ci/run composer install)" >&2
            exit 0
            ;;
    esac
    echo "run-captainhook: vendor/bin/captainhook missing; run: docker/ci/run composer install" >&2
    exit 1
fi

if [[ "${JAVMETA_HOOKS_ON_HOST:-0}" == "1" ]]; then
    exec vendor/bin/captainhook "$@"
fi

exec docker/ci/run vendor/bin/captainhook "$@"
