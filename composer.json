{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "jooservices/javmeta",
    "type": "project",
    "description": "Laravel POC API and crawl worker for JAV metadata normalization.",
    "keywords": [
        "javmeta",
        "laravel",
        "metadata",
        "poc"
    ],
    "license": "MIT",
    "require": {
        "ext-redis": "^6.3",
        "php": "^8.5",
        "jooservices/client": "^4.4.1",
        "jooservices/crawlerx": "^1.3",
        "jooservices/dto": "^3.0",
        "jooservices/exceptions": "^4.0",
        "jooservices/laravel-config": "^4.0",
        "jooservices/laravel-controller": "^4.0",
        "jooservices/laravel-logging": "^4.0",
        "jooservices/laravel-notifications": "^1.0.1",
        "jooservices/laravel-repository": "^4.0",
        "laravel/framework": "^13",
        "laravel/tinker": "^3",
        "mongodb/mongodb": "^2.0"
    },
    "require-dev": {
        "captainhook/captainhook": "^5.23",
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.75",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpmd/phpmd": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.13.6 || ^4.0.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "hooks:install": "captainhook install --force --skip-existing",
        "lint:pint": "pint --test",
        "lint:pint:fix": "pint",
        "lint:phpcs": "phpcs --standard=phpcs.xml",
        "lint:phpmd": "vendor/bin/phpmd analyze app tests --format text --ruleset phpmd.xml --no-progress",
        "lint:phpstan": "XDEBUG_MODE=off phpstan analyse --configuration=phpstan.neon --memory-limit=512M",
        "lint:cs": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --sequential",
        "lint:cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --sequential",
        "lint": [
            "@lint:pint",
            "@lint:phpcs",
            "@lint:phpmd",
            "@lint:phpstan",
            "@lint:cs"
        ],
        "lint:fix": [
            "@lint:pint:fix",
            "@lint:cs:fix"
        ],
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan serve"
        ],
        "test": [
            "@php -r \"file_exists('.env') || touch('.env');\"",
            "@php artisan config:clear --ansi",
            "APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= APP_NAME=javmeta php artisan test"
        ],
        "test:coverage": [
            "@php -r \"file_exists('.env') || touch('.env');\"",
            "@php artisan config:clear --ansi",
            "XDEBUG_MODE=coverage APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= APP_NAME=javmeta php artisan test --coverage-clover=build/coverage.xml"
        ],
        "test:shell": [
            "bash tests/Shell/worker-queues.test.sh",
            "bash tests/Shell/run-captainhook.test.sh"
        ],
        "coverage:report": "php tools/coverage-report.php build/coverage.xml build/coverage/uncovered-files.md",
        "coverage:check": "php tools/coverage-enforce.php build/coverage.xml 90",
        "check": [
            "@lint",
            "@test",
            "@test:shell"
        ],
        "ci": [
            "@lint",
            "@test:coverage",
            "@coverage:report",
            "@coverage:check",
            "@test:shell"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "captainhook/plugin-composer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
