#!/usr/bin/env bash
# Run the Integration suite against the Workspaces SHARED Docker services (no compose stack).
#   docker/ci/integration-shared                 # whole suite
#   docker/ci/integration-shared --filter Movie  # extra PHPUnit arguments
#
# Prerequisite (once): scripts/docker/shared provision-javmeta-test  (creates the JAVMETA_IT_* namespaces).
# Credentials are read from the private Workspaces root .env into a temporary 0600 env file that is
# removed on exit; values are never printed. The Mongo outage test is skipped (it would stop a shared
# service); it still runs in CI through docker/ci/integration.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
workspaces="${JAVMETA_WORKSPACES_ROOT:-$HOME/Workspaces}"
workspaces_env="${workspaces}/.env"
image="${JAVMETA_CI_IMAGE:-javmeta-ci:local}"

[[ -f "$workspaces_env" && ! -L "$workspaces_env" ]] || { echo "Workspaces root .env not found: $workspaces_env" >&2; exit 2; }
[[ "$(stat -f '%Lp' "$workspaces_env" 2>/dev/null || stat -c '%a' "$workspaces_env")" == "600" ]] || { echo "Workspaces root .env must be mode 0600." >&2; exit 2; }

env_file="$(mktemp "${TMPDIR:-/tmp}/javmeta-it-env.XXXXXX")"
chmod 600 "$env_file"
trap 'rm -f "$env_file"' EXIT

python3 -I - "$workspaces_env" "$env_file" <<'PY'
import sys, urllib.parse

source, target = sys.argv[1], sys.argv[2]
values = {}
for line in open(source, encoding="utf-8"):
    row = line.strip()
    if row and not row.startswith("#") and "=" in row:
        key, value = row.split("=", 1)
        values[key.removeprefix("export ").strip()] = value.strip().strip('"').strip("'")

required = (
    "JAVMETA_IT_POSTGRES_USER", "JAVMETA_IT_POSTGRES_PASSWORD", "JAVMETA_IT_POSTGRES_DATABASE",
    "JAVMETA_IT_MONGODB_USER", "JAVMETA_IT_MONGODB_PASSWORD", "JAVMETA_IT_MONGODB_DATABASE",
    "JAVMETA_IT_ELASTIC_USER", "JAVMETA_IT_ELASTIC_PASSWORD",
    "JAVMETA_IT_OPENOBSERVE_EMAIL", "JAVMETA_IT_OPENOBSERVE_PASSWORD",
)
missing = [key for key in required if not values.get(key)]
if missing:
    sys.exit("Missing JAVMETA_IT_* keys in the Workspaces .env (run scripts/docker/shared provision-javmeta-test): " + ", ".join(missing))

quote = lambda text: urllib.parse.quote(text, safe="")
host = "host.docker.internal"
mongo_db = values["JAVMETA_IT_MONGODB_DATABASE"]
out = {
    "DB_HOST": host,
    "DB_PORT": "15435",
    "DB_DATABASE": values["JAVMETA_IT_POSTGRES_DATABASE"],
    "DB_USERNAME": values["JAVMETA_IT_POSTGRES_USER"],
    "DB_PASSWORD": values["JAVMETA_IT_POSTGRES_PASSWORD"],
    "MONGO_URI": f"mongodb://{quote(values['JAVMETA_IT_MONGODB_USER'])}:{quote(values['JAVMETA_IT_MONGODB_PASSWORD'])}@{host}:27022/{mongo_db}?authSource={mongo_db}",
    "ELASTICSEARCH_HOST": f"http://{quote(values['JAVMETA_IT_ELASTIC_USER'])}:{quote(values['JAVMETA_IT_ELASTIC_PASSWORD'])}@{host}:19200",
    "OPENOBSERVE_URL": f"http://{host}:15080",
    "OPENOBSERVE_EMAIL": values["JAVMETA_IT_OPENOBSERVE_EMAIL"],
    "OPENOBSERVE_PASSWORD": values["JAVMETA_IT_OPENOBSERVE_PASSWORD"],
}
# OpenObserve generates its own organization identifier; the test account lists only its own org.
import base64, json, urllib.request
token = base64.b64encode(f"{values['JAVMETA_IT_OPENOBSERVE_EMAIL']}:{values['JAVMETA_IT_OPENOBSERVE_PASSWORD']}".encode()).decode()
request = urllib.request.Request("http://127.0.0.1:15080/api/organizations", headers={"Authorization": "Basic " + token})
import time
payload = None
for attempt in range(3):
    try:
        payload = json.load(urllib.request.urlopen(request, timeout=30))
        break
    except Exception as error:  # noqa: BLE001 - report without leaking details
        if attempt == 2:
            sys.exit(f"Could not list the OpenObserve organization with the test account ({type(error).__name__}).")
        time.sleep(5)
items = payload.get("data") or payload.get("organizations") or payload.get("list") or payload if isinstance(payload, dict) else payload
wanted = values.get("JAVMETA_IT_OPENOBSERVE_ORG", "javmeta_it")
match = [item for item in items if isinstance(item, dict) and item.get("name") == wanted]
if len(match) != 1 or not match[0].get("identifier"):
    sys.exit("The OpenObserve test organization was not found; run scripts/docker/shared provision-javmeta-test.")
out["OPENOBSERVE_ORG"] = match[0]["identifier"]
out["OPENOBSERVE_STREAM_LOGS"] = values.get("JAVMETA_IT_OPENOBSERVE_STREAM", "javmeta_it_logs")
with open(target, "w", encoding="utf-8") as handle:
    for key, value in out.items():
        handle.write(f"{key}={value}\n")
PY

docker run --rm \
  --user "$(id -u):$(id -g)" \
  --add-host host.docker.internal:host-gateway \
  --env HOME=/tmp \
  --env-file "$env_file" \
  --volume "${root}:/app" \
  --workdir /app \
  "$image" vendor/bin/phpunit --configuration phpunit.integration.xml "$@"
