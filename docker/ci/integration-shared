#!/usr/bin/env bash
# Run the Integration suite against the Workspaces SHARED services in the shared PHP runtime.
#   docker/ci/integration-shared                          # javmeta_test
#   JAVMETA_MODE=wt:<id> docker/ci/integration-shared     # a worktree database
#   docker/ci/integration-shared --filter Movie           # extra PHPUnit arguments
#
# Prerequisite (once per project/worktree): scripts/docker/shared provision-project javmeta --postgres --mongodb --redis [--db <id>]
# Databases are verified with check-project before anything runs. The Mongo outage test is skipped
# (it would stop a shared service); it still runs in GitHub CI through docker/ci/integration.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
exec "$root/docker/dev/shared-run" --mode "${JAVMETA_MODE:-test}" -- vendor/bin/phpunit --configuration phpunit.integration.xml "$@"
