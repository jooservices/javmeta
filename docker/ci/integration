#!/usr/bin/env bash
# Run the Integration suite against real Postgres, Mongo, Elasticsearch and OpenObserve.
#   docker/ci/integration                 # whole suite
#   docker/ci/integration --filter Movie  # extra PHPUnit arguments
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
compose=(docker compose --file "${root}/docker/ci/compose.integration.yml")

JAVMETA_CI_UID="$(id -u)"
JAVMETA_CI_GID="$(id -g)"
export JAVMETA_CI_UID JAVMETA_CI_GID
export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-javmeta-integration}"
# Authenticated Elasticsearch is required to prove the production API-key restrictions.
export JAVMETA_CI_ES_SECURITY=true JAVMETA_PRODUCTION_PROVISIONING=1
if [[ -z "${JAVMETA_CI_APP_KEY:-}" ]]; then
  JAVMETA_CI_APP_KEY="base64:$(openssl rand -base64 32 | tr -d '\n')"
fi
export JAVMETA_CI_APP_KEY
JAVMETA_CI_ES_PASSWORD="$(openssl rand -hex 24)"
export JAVMETA_CI_ES_PASSWORD
JAVMETA_CI_XCRAWLER_MONGO_PASSWORD="$(openssl rand -hex 24)"
export JAVMETA_CI_XCRAWLER_MONGO_PASSWORD
signal_id="$$"
signal_dir="$(mktemp -d "${TMPDIR:-/tmp}/javmeta-integration-outage.XXXXXX")"
export JAVMETA_INTEGRATION_SIGNAL_DIR="$signal_dir"
ready_signal="${signal_dir}/mongo-outage-${signal_id}.ready"
stopped_signal="${signal_dir}/mongo-outage-${signal_id}.stopped"
failure_signal="${signal_dir}/mongo-outage-${signal_id}.failed"
docker volume create javmeta-ci-composer-cache >/dev/null

cleanup() {
  "${compose[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true
  rm -f "$ready_signal" "$stopped_signal" "$failure_signal"
  rmdir "$signal_dir" 2>/dev/null || true
}
trap cleanup EXIT

if [[ "${JAVMETA_CI_SKIP_BUILD:-0}" != "1" ]]; then
  "${compose[@]}" build --quiet gate
fi
# Registry rate limits are transient; retry the image pulls before failing the run.
for attempt in 1 2 3; do
  "${compose[@]}" pull --quiet postgres mongo redis elasticsearch openobserve && break
  [[ "$attempt" -lt 3 ]] || { echo "Could not pull the integration service images." >&2; exit 1; }
  sleep 20
done
"${compose[@]}" up --detach --wait postgres mongo elasticsearch
"${compose[@]}" exec --no-TTY mongo mongosh --quiet --file /tmp/xcrawler-mongodb.js
"${compose[@]}" exec --no-TTY mongo mongosh --quiet --file /tmp/xcrawler-mongodb.js
"${compose[@]}" up --detach openobserve
"${compose[@]}" run --rm gate vendor/bin/phpunit --configuration phpunit.integration.xml "$@"

run_mongo_outage_test=false
if [[ $# -eq 0 ]]; then
  run_mongo_outage_test=true
else
  for argument in "$@"; do
    if [[ "$argument" == *RuntimeDependencyHealthTest* ]]; then
      run_mongo_outage_test=true
      break
    fi
  done
fi

if [[ "$run_mongo_outage_test" == "true" ]]; then
  "${compose[@]}" run --rm \
    --env JAVMETA_INTEGRATION_STOP_MONGO=1 \
    --env "JAVMETA_MONGO_OUTAGE_SIGNAL_ID=${signal_id}" \
    gate vendor/bin/phpunit --configuration phpunit.integration.xml --filter RuntimeDependencyHealthTest &
  test_pid=$!

  ready=false
  for ((attempt = 1; attempt <= 600; attempt++)); do
    if [[ -f "$ready_signal" ]]; then
      ready=true
      break
    fi
    if ! kill -0 "$test_pid" 2>/dev/null; then
      break
    fi
    sleep 0.05
  done

  if [[ "$ready" == "true" ]]; then
    if ! "${compose[@]}" stop mongo >/dev/null; then
      : > "$failure_signal"
    fi
  else
    : > "$failure_signal"
  fi
: > "$stopped_signal"

  set +e
  wait "$test_pid"
  test_status=$?
  set -e
  if [[ "$test_status" -ne 0 ]]; then
    exit "$test_status"
  fi
fi
